rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is a member of a workspace
    function isWorkspaceMember(workspaceId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids;
    }

    // Users collection: Private
    // Privileged fields (role, limits, counters) can never be set from the client.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.totalUrls == 0
                    && request.resource.data.maxUrls == 10000;

      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid', 'role', 'maxUrls', 'totalUrls', 'createdAt']);

      allow delete: if false;
    }

    // Workspaces collection: Only members can read. 
    // Creation and updates are handled via the NestJS API.
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow write: if false;
    }

    // Short URLs: Public read ONLY for unprotected links. Protected links must be resolved via the backend API.
    match /shortUrls/{shortCode} {
      allow read: if !resource.data.passwordProtected 
                  || (request.auth != null && (resource.data.userId == request.auth.uid || isWorkspaceMember(resource.data.workspaceId)));

      // All writes go through the NestJS API (admin SDK). Clients can never write link documents directly,
      // which keeps counters, ownership, password hashes and expiry server-controlled.
      allow create, update, delete: if false;

      // Clicks sub-collection: Managed by the backend.
      // Owners can read their own analytics data directly if needed.
      match /clicks/{clickId} {
        allow read: if request.auth != null 
                    && get(/databases/$(database)/documents/shortUrls/$(shortCode)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // Unique Visitors: Managed by the backend.
    // Owners can read visitors associated with their links.
    match /uniqueVisitors/{visitorId} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/shortUrls/$(resource.data.shortCode))
                  && get(/databases/$(database)/documents/shortUrls/$(resource.data.shortCode)).data.userId == request.auth.uid;
      allow write: if false;
    }

    // Stats: Global metadata.
    match /stats/{global} {
      allow read: if true;
      // Written only by the backend (admin SDK); clients may just read the public counter.
      allow write: if false;
    }
  }
}
